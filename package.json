{
  "name": "technologist-academy-node-service-template",
  "version": "1.0.0",
  "description": "A template repository for node services developed in the Technologist Academy",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate --config prisma.config.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "lint": "biome lint src",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "test": "vitest run",
    "migrate": "npx prisma migrate dev",
    "seed": "npx prisma db seed",
    "migrateExisting": "npx prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "^6.1.0",
    "pg": "^8.23.1"
  }
}